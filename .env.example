# ===== Database =====
# Supabase: Settings > Database > Connection string (URI mode)
# Neon:     Dashboard > Connection Details
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"

# ===== NextAuth v5 =====
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-char-random-string"
AUTH_SECRET="replace-with-32-char-random-string"

# ===== App URL =====
NEXTAUTH_URL="https://your-domain.com"

# ===== Notifications =====
NOTIFICATION_ADAPTER="console"

# SMTP (ถ้าใช้ NOTIFICATION_ADAPTER=smtp)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="app-password-here"
# SMTP_FROM="noreply@your-domain.com"
